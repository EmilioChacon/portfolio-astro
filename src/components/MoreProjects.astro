---
import { getCollection } from 'astro:content';

// Fetch all projects and sort them by order
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section class="max-w-7xl mx-auto px-6 lg:px-10 py-16 border-b border-outline-variant/30">
<div class="flex items-center justify-between mb-8">
<div>
<span class="text-label-md font-label-md text-secondary uppercase tracking-widest block mb-1">Systems &amp; Logic Artifacts</span>
<h2 class="text-headline-md font-headline-md text-on-surface">Más proyectos</h2>
</div>
<span class="text-body-sm font-body-sm text-outline">
          {sortedProjects.length} repositories cataloged
        </span>
</div>
<div class="border-t border-outline-variant/40 divide-y divide-outline-variant/30">
  {sortedProjects.map((project, index) => (
    <div class="py-5 flex flex-col md:flex-row md:items-center justify-between gap-4 group hover:bg-surface-container-lowest transition-colors px-2 rounded">
      <div class="flex items-start md:items-center gap-4">
        <span class="text-label-md font-label-md text-outline">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div>
          <a class="text-title-md font-title-md text-on-surface hover:text-primary transition-colors inline-flex items-center gap-1.5 font-medium" href={project.data.githubUrl} rel="noopener noreferrer" target="_blank">
            {project.data.title}
            <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors text-sm" data-icon="north_east">north_east</span>
          </a>
          <p class="text-body-sm font-body-sm text-on-surface-variant mt-0.5">
            {project.data.description}
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="px-2.5 py-1 rounded border border-outline-variant/50 text-label-sm font-label-sm text-on-surface bg-surface-container-low">{project.data.tags[0]}</span>
        {project.data.tags[1] && (
          <span class="px-2.5 py-1 rounded border border-outline-variant/50 text-label-sm font-label-sm text-outline">{project.data.tags[1]}</span>
        )}
      </div>
    </div>
  ))}
</div>
</section>
