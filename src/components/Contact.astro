---
---

<!-- CONTACT SECTION -->
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-16" id="contact">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
<!-- Left: Pitch & Social Channels -->
<div class="lg:col-span-5 flex flex-col justify-between">
<div>
<span class="text-label-md font-label-md text-secondary uppercase tracking-widest block mb-1">Direct Connection</span>
<h2 class="text-headline-md font-headline-md text-on-surface mb-4">Iniciemos una conversación técnica</h2>
<p class="text-body-md font-body-md text-on-surface-variant mb-6 leading-relaxed">
              Disponible para incorporarme a equipos de backend que valoren la arquitectura limpia, las pruebas automatizadas y la responsabilidad técnica en Java, Spring Boot y microservicios.
            </p>
<div class="space-y-3 mb-8">
<a class="flex items-center gap-3 text-body-sm font-body-sm text-on-surface hover:text-primary transition-colors" href="https://github.com/EmilioChacon" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-outline" data-icon="folder_code">folder_code</span>
<span class="">github.com/EmilioChacon</span>
</a>
<a class="flex items-center gap-3 text-body-sm font-body-sm text-on-surface hover:text-primary transition-colors" href="https://www.linkedin.com/in/emilio-dlp-chacon/" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-outline" data-icon="badge">badge</span>
<span class="">linkedin.com/in/emilio-dlp-chacon/</span>
</a>
<div class="flex items-center gap-3 text-body-sm font-body-sm text-on-surface">
<span class="material-symbols-outlined text-outline" data-icon="location_on">location_on</span>
<span class="">Alicante, Spain (Open to Remote &amp; Hybrid)</span>
</div>
</div>
</div>
<div class="p-4 rounded-2xl border border-outline-variant/40 bg-surface-container-low">
<span class="text-label-sm font-label-sm text-secondary font-semibold uppercase block mb-1 tracking-wider">Status</span>
<p class="text-body-sm font-body-sm text-on-surface">
Ready for immediate technical interviews and coding reviews.
</p>
</div>
</div>
<!-- Right: Clean Minimal Contact Form -->
<div class="lg:col-span-7 bg-surface-container-lowest border border-outline-variant/40 p-6 md:p-8 rounded-3xl shadow-sm">
<form class="space-y-4" onsubmit="event.preventDefault(); alert('Message noted! Thank you for reaching out.');">
<!-- Honeypot for spam mitigation -->
<div aria-hidden="true" class="hidden">
<label class="" for="honeypot">If you are human, leave this field empty:</label>
<input autocomplete="off" id="honeypot" name="honeypot" tabindex="-1" type="text">
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1 font-medium" for="fullname">Full Name</label>
<input class="w-full text-body-sm font-body-sm rounded-xl border border-outline-variant bg-surface-container-lowest px-3.5 py-2.5 text-on-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container outline-none transition-colors" id="fullname" placeholder="e.g. Elena Rostova" required="" type="text">
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1 font-medium" for="email">Contact Email</label>
<input class="w-full text-body-sm font-body-sm rounded-xl border border-outline-variant bg-surface-container-lowest px-3.5 py-2.5 text-on-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container outline-none transition-colors" id="email" placeholder="name@company.com" required="" type="email">
</div>
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1 font-medium" for="company">Company (Optional)</label>
<input class="w-full text-body-sm font-body-sm rounded-xl border border-outline-variant bg-surface-container-lowest px-3.5 py-2.5 text-on-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container outline-none transition-colors" id="company" placeholder="Organization or project name" type="text">
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1 font-medium" for="message">Message</label>
<textarea class="w-full text-body-sm font-body-sm rounded-xl border border-outline-variant bg-surface-container-lowest px-3.5 py-2.5 text-on-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container outline-none transition-colors" id="message" placeholder="Share details regarding your backend role, technical challenges, or requirements..." required="" rows="4"></textarea>
</div>
<button class="w-full py-3 px-6 rounded-xl bg-primary-container text-on-primary text-title-md font-title-md hover:bg-primary transition-colors flex items-center justify-center gap-2 active:scale-[0.99]" type="submit">
<span class="">Send Message</span>
<span class="material-symbols-outlined text-[18px]" data-icon="send">send</span>
</button>
</form>
</div>
</div>
</section>
